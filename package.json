{
  "name": "pi-anchorloop",
  "version": "2.0.0",
  "description": "Agent workflow skills for pi: one entry skill per task type, each with playbooks, over a shared Align → Anchor → Act → Verify loop, plus loop extensions (anchor gate, decision trail tool, Jev second thought, skill validator, stream rules).",
  "author": "Wei Hung",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/anchorloop.git"
  },
  "homepage": "https://github.com/wayne930242/anchorloop#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "anchorloop",
    "agent-workflow",
    "skills",
    "playbooks"
  ],
  "files": [
    "pi",
    "skills",
    "hooks/validate_tool_use.py",
    "hooks/validators/*.py",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./pi/validate-tool-use.ts",
      "./pi/ttsr.ts",
      "./pi/anchor-gate.ts",
      "./pi/decision-tool.ts",
      "./pi/second-thought.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
